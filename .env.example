# ==============================================================================
# DATABASE CONFIGURATION
# ==============================================================================
# For Local Development or Production (PostgreSQL - Neon, Supabase, or Vercel Postgres):
# Use a direct connection string for migrations and a pooled connection string at runtime.
DATABASE_URL="postgresql://user:password@ep-xyz-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require"

# ==============================================================================
# AUTHENTICATION & SECURITY
# ==============================================================================
# Generate a strong 32+ character random secret in terminal: openssl rand -base64 32
JWT_SECRET="your-super-secure-production-jwt-secret-key-min-32-chars-long"

# ==============================================================================
# APPLICATION URL
# ==============================================================================
# Set to your live production domain (e.g., https://admissions.xyzcollege.edu)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ==============================================================================
# DEMO ACCESS (OPTIONAL)
# ==============================================================================
# Set to "false" in real production to hide the 1-click demo login buttons
NEXT_PUBLIC_SHOW_DEMO_LOGINS="true"
